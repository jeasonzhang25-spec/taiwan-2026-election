{
  "name": "island-election-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "2026 台灣九合一選舉公開民調與選情看板",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run test:contracts && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "sync:polls": "python3 scripts/sync-public-polls.py",
    "sync:candidates": "python3 scripts/sync-candidate-registry.py",
    "sync:policies": "python3 scripts/sync-candidate-policies.py",
    "sync:election-data": "npm run sync:polls && npm run sync:candidates && npm run sync:policies",
    "validate:polls": "python3 scripts/validate-public-polls.py",
    "verify:poll-sources": "python3 scripts/verify-poll-sources.py",
    "test:contracts": "tsx scripts/validate-site-contract.ts",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-build-budget.mjs",
    "quality": "npm run validate:polls && npm run sync:candidates -- --offline --no-write && npm run sync:policies -- --offline --no-write && npm run test:contracts && npm run typecheck && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "next": "16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4"
  }
}
